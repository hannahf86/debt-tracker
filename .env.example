# Copy to .env.local and fill in. .env.local is gitignored.
#
# Note: the example file is named .env.example, not .env.local.example —
# the `.env.local.*` rule in .gitignore (there to catch secret-carrying
# backups) would silently swallow the latter.

# --- Supabase -------------------------------------------------------------
# Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Used for auth.admin.* calls (password change, account delete,
# reading profile metadata) because the app authenticates through NextAuth and
# so has no Supabase user JWT to act on behalf of. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- NextAuth -------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# --- Dev-only auth bypass (optional) --------------------------------------
# Skips login for local screenshots and design work. Ignored unless
# NODE_ENV !== "production", so it cannot disable auth in a deployed build.
# Leave both unset for normal development.
# NEXT_PUBLIC_DEV_NO_AUTH=true
# DEV_USER_ID=            # which account to browse as; defaults to the first user
